{
  "kokoro": {
    "backend": "command",
    "kinds": ["voice"],
    "about": "Kokoro-82M ONNX narration (CPU). Setup: docs/LOCAL_WORKERS.md",
    "argv": ["workers/kokoro/.venv/Scripts/python.exe", "workers/kokoro/worker.py", "--request", "{request}", "--out", "{out}"],
    "models": ["workers/kokoro/kokoro-v1.0.onnx", "workers/kokoro/voices-v1.0.bin"],
    "fields": ["prompt", "text", "voice", "lang", "speed"],
    "limits": {
      "max_chars": 2000
    },
    "device": "cpu",
    "timeout": 900
  },
  "stable-audio": {
    "backend": "command",
    "kinds": ["music", "sfx"],
    "about": "Stable Audio 3 Small music/SFX, official Windows LiteRT CPU worker. Setup: docs/LOCAL_WORKERS.md",
    "argv": ["workers/stable-audio/.venv/Scripts/python.exe", "workers/stable-audio/worker.py", "--request", "{request}", "--out", "{out}"],
    "models": ["workers/stable-audio/models"],
    "fields": ["prompt", "seed", "duration"],
    "limits": {
      "max_seconds": 30
    },
    "device": "cpu",
    "timeout": 1800
  },
  "flux-klein": {
    "backend": "comfyui",
    "kinds": ["image"],
    "about": "FLUX.2 klein 4B distilled (fp8, 4 steps) text-to-image through local ComfyUI v0.39.2 on ROCm. Setup: docs/LOCAL_WORKERS.md",
    "workflow": "workers/comfyui/workflows/flux2_klein_api.json",
    "output_node": "9",
    "output_type": "images",
    "node_classes": ["UNETLoader", "CLIPLoader", "Flux2Scheduler", "EmptyFlux2LatentImage", "SamplerCustomAdvanced", "VAEDecodeTiled"],
    "models": ["workers/comfyui/app/models/diffusion_models/flux-2-klein-4b-fp8.safetensors", "workers/comfyui/app/models/text_encoders/qwen_3_4b.safetensors", "workers/comfyui/app/models/vae/flux2-vae.safetensors", "workers/comfyui/app/comfyui_version.py", "workers/comfyui/.venv/Lib/site-packages/torch/version.py", "workers/comfyui/.venv/pyvenv.cfg"],
    "fields": ["prompt", "seed", "width", "height"],
    "limits": {
      "max_height": 1024,
      "max_width": 1024
    },
    "device": "gpu",
    "timeout": 1800
  },
  "wan": {
    "backend": "comfyui",
    "kinds": ["video"],
    "about": "Wan2.1 1.3B short text-to-video through local ComfyUI (experimental). Setup: docs/LOCAL_WORKERS.md",
    "workflow": "workers/comfyui/workflows/wan21_t2v_1.3b_api.json",
    "output_node": "save",
    "output_type": "images",
    "fields": ["prompt", "seed", "width", "height", "duration", "fps"],
    "limits": {
      "max_width": 832,
      "max_seconds": 2.0625,
      "max_height": 480,
      "max_fps": 16,
      "max_frames": 33,
      "frame_step": 4
    },
    "device": "gpu",
    "timeout": 1800,
    "models": ["workers/comfyui/app/models/diffusion_models/wan2.1_t2v_1.3B_fp16.safetensors", "workers/comfyui/app/models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors", "workers/comfyui/app/models/vae/wan_2.1_vae.safetensors", "workers/comfyui/app/comfyui_version.py", "workers/comfyui/.venv/Lib/site-packages/torch/version.py", "workers/comfyui/.venv/pyvenv.cfg"],
    "node_classes": ["CLIPLoader", "UNETLoader", "ModelSamplingSD3", "EmptyHunyuanLatentVideo", "KSampler", "CreateVideo", "SaveVideo", "VAEDecodeTiled"]
  },
  "flux-klein-edit": {
    "backend": "comfyui",
    "kinds": ["image"],
    "about": "FLUX.2 klein 4B distilled reference edit (one init image, ~1 MP output) through local ComfyUI. Setup: docs/LOCAL_WORKERS.md",
    "workflow": "workers/comfyui/workflows/flux2_klein_edit_api.json",
    "output_node": "9",
    "output_type": "images",
    "uploads": {
      "init": {
        "node": "76",
        "input": "image"
      }
    },
    "node_classes": ["LoadImage", "ImageScaleToTotalPixels", "GetImageSize", "ReferenceLatent", "Flux2Scheduler", "VAEDecodeTiled"],
    "models": ["workers/comfyui/app/models/diffusion_models/flux-2-klein-4b-fp8.safetensors", "workers/comfyui/app/models/text_encoders/qwen_3_4b.safetensors", "workers/comfyui/app/models/vae/flux2-vae.safetensors", "workers/comfyui/app/comfyui_version.py", "workers/comfyui/.venv/Lib/site-packages/torch/version.py", "workers/comfyui/.venv/pyvenv.cfg"],
    "fields": ["prompt", "seed", "references", "width", "height"],
    "device": "gpu",
    "timeout": 1800
  }
}
