{
  "version": 1,
  "name": "bg-replace",
  "sources": {
    "clip": {"path": "D:/footage/interview_4k60.mp4"},
    "plate": {"path": "D:/footage/new_background.jpg"},
    "logo": {"path": "D:/footage/logo.png"}
  },
  "steps": [
    {"id": "cut", "op": "trim", "inputs": ["clip"], "params": {"start": 3.0, "end": 18.0}},
    {"id": "matte", "op": "mask", "inputs": ["cut"], "params": {"target": "person", "model": "birefnet-portrait", "stride": 2}},
    {"id": "comp", "op": "background", "inputs": ["cut", "matte", "plate"], "params": {"mode": "replace", "feather": 2, "refine": 4}},
    {"id": "brand", "op": "overlay", "inputs": ["comp", "logo"], "params": {"x": "W-w-80", "y": 80, "width": 360, "opacity": 0.9}},
    {"id": "loud", "op": "loudnorm", "inputs": ["brand"], "params": {"I": -16}}
  ],
  "output": "D:/footage/renders/interview_bg.mp4",
  "profile": "4k60-master",
  "proxy_height": 540,
  "retries": 1,
  "validate": {"against": "clip", "duration": 15.0}
}
